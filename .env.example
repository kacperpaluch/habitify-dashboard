# Port, pod którym otworzysz dashboard
APP_PORT=8080

# Klucz z Habitify: Settings > API. Nigdy nie commituj pliku .env.
HABITIFY_API_KEY=

# 0 wyłącza automatyczną synchronizację. Przycisk ręczny nadal działa.
SYNC_INTERVAL_MINUTES=30

# Backup SQLite raz dziennie według strefy TZ
BACKUP_TIME=03:00
BACKUP_KEEP=14
MAX_BACKUP_MB=100

TZ=Europe/Warsaw
